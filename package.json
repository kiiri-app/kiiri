{
  "name": "kiri",
  "productName": "Kiiri",
  "version": "0.1.38",
  "description": "A companion cat on your desktop — pomodoro + health-aware pet for coders",
  "author": "Ahmet Vural",
  "license": "MIT",
  "homepage": "https://kiiri.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiiri-app/kiiri.git"
  },
  "bugs": {
    "url": "https://github.com/kiiri-app/kiiri/issues"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --kiri-smoke-test",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "build:poses": "python3 scripts/build-pose-sheets.py",
    "pack": "electron-builder --dir --publish never -c.mac.identity=-",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.kiri.app",
    "productName": "Kiiri",
    "copyright": "Copyright © 2026 Ahmet Vural",
    "publish": [
      {
        "provider": "github",
        "owner": "kiiri-app",
        "repo": "kiiri-releases",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "characters.js",
      "userdata-path.js",
      "ai/**",
      "renderer/**",
      "editor/**",
      "hooks/**",
      "agents/**",
      "workspace/**",
      "svg/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kiiri uses the microphone only while you hold push-to-talk or tap the mic button.",
        "NSAppleEventsUsageDescription": "Kiiri checks which app is in front so its answers fit what you're doing."
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
