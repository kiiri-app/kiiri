{
  "name": "kiri",
  "productName": "Kiri",
  "version": "0.1.38",
  "description": "A companion cat on your desktop — pomodoro + health-aware pet for coders",
  "author": "Ahmet Vural",
  "license": "MIT",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --kiri-smoke-test",
    "build:posesvgs": "node scripts/build-pose-svgs.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "docx": "^9.7.1",
    "pptxgenjs": "^4.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "dev.kiri.app",
    "productName": "Kiri",
    "copyright": "Copyright © 2026 Ahmet Vural",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "ai/**",
      "renderer/**",
      "editor/**",
      "hooks/**",
      "agents/**",
      "workspace/**",
      "svg/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kiri sesli komutları anlamak için mikrofonu kullanır."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
